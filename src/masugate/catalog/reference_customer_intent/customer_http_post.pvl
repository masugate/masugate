policy customer_http_post on http.post {
  deny owner_capability_denied when owner.action_permitted(principal.id, "http.post") == false;
  deny owner_target_denied when owner.target_permitted(principal.id, "http.post", args.destination) == false;
  escalate owner_ask_first when owner.approval_required(principal.id, "http.post") == true;
  allow otherwise;
}
