policy customer_api_spend on api_spend {
  deny owner_capability_denied when owner.action_permitted(principal.id, "api_spend") == false;
  deny owner_target_denied when owner.target_permitted(principal.id, "api_spend", args.service) == false;
  escalate owner_ask_first when owner.approval_required(principal.id, "api_spend") == true;
  allow otherwise;
}
