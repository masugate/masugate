policy customer_workspace_write on fs.write {
  deny owner_capability_denied when owner.action_permitted(principal.id, "fs.write") == false;
  deny owner_target_denied when owner.target_permitted(principal.id, "fs.write", args.path) == false;
  escalate owner_ask_first when owner.approval_required(principal.id, "fs.write") == true;
  allow otherwise;
}
