policy customer_channel_post on channel.post {
  deny owner_capability_denied when owner.action_permitted(principal.id, "channel.post") == false;
  deny owner_target_denied when owner.target_permitted(principal.id, "channel.post", args.channel) == false;
  escalate owner_ask_first when owner.approval_required(principal.id, "channel.post") == true;
  allow otherwise;
}
