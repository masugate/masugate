policy customer_workspace_delete on fs.delete {
  deny owner_capability_denied when owner.action_permitted(principal.id, "fs.delete") == false;
  deny owner_target_denied when owner.target_permitted(principal.id, "fs.delete", args.path) == false;
  escalate owner_ask_first when owner.approval_required(principal.id, "fs.delete") == true;
  allow otherwise;
}
