{
  "schema_version": "masugate.release-control-policy/v1",
  "status": "source-release-staged",
  "scope": "research-preview-source-staging",
  "release_environment": "not-configured",
  "activation": {
    "source_repository": "private",
    "source_ci": "enabled",
    "requires": [
      "make the source repository public",
      "configure release environment and protected-branch review",
      "fresh verification of source controls and action locks"
    ]
  },
  "publication": {
    "trusted_publishers": "not-configured",
    "container_attestation": "not-configured",
    "long_lived_publication_secrets": "prohibited",
    "source_repository": "private",
    "package_and_container_artifacts": "not-published"
  },
  "two_person_control": {
    "minimum_distinct_approvers": 2,
    "applies_to": [
      "release-environment approval",
      "publishing-workflow change",
      "publisher or owner-role change",
      "namespace or domain transfer",
      "release deletion"
    ],
    "required_future_enforcement": "repository release environment and protected-branch/tag rules",
    "identity_assignment": "configured outside the source tree"
  },
  "custody_boundary": "Operational account access does not assign or prove ownership of copyrights, patents, trademarks, or other intellectual property."
}
